NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render internal connections use the private network; external connections use verified TLS.
DATABASE_SSL=auto
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_USERNAME=zudo
OWNER_PASSWORD=replace-with-your-requested-owner-password
SMM_API_URL=https://mysmm.org/api/v2
SMM_API_KEY=replace-with-your-supplied-real-api-key
UPI_ID=Fearlessaditya@fam
# Must be INR for this INR wallet. Ordering fails closed on another provider currency.
PROVIDER_CURRENCY=INR
# Optional exact public origin. Render hostname is detected automatically.
APP_ORIGIN=
